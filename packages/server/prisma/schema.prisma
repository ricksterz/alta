// Alta schema — Phase 1 (advisor/investor onboarding) + Phase 2 (GP/sponsor
// fund & document-template management).
// Multi-tenant subscription document execution platform.
//
// Tenant isolation strategy: every tenant-owned table carries a tenant-owning
// column (tenantId for advisor-side tables, sponsorTenantId for sponsor-side
// tables — deliberately different names so code can't silently apply the
// wrong tenant's filter) as its first non-id column. Enforcement is at the
// query layer: every route request goes through a per-request Prisma Client
// Extension (src/db/scopedClient.ts) bound to the caller's tenantId, which
// injects a `where: { <tenantColumn> }` on every read/bulk-write and stamps
// it onto every create, with unsafe single-record operations (findUnique,
// update, delete, upsert) disabled outright.
//
// This is NOT backed by composite foreign keys — every relation below is a
// plain single-column FK on `id`, not `(tenantId, id)`. The database itself
// does not prevent, say, a Subscription in Tenant A from pointing investorId
// at an Investor in Tenant B; that's prevented entirely by application code
// only ever sourcing related IDs from an already tenant-scoped lookup. As of
// Phase 2 this is intentional in one specific place — Subscription.fundId
// legitimately points at a Fund owned by a different (sponsor) tenant — so
// the DB-level guarantee was never going to be "no cross-tenant FK ever",
// only "no cross-tenant FK by accident." Worth revisiting with real
// composite FKs (@@unique([tenantId, id]) + composite relations) if this
// starts handling data where that distinction needs to be airtight rather
// than code-reviewed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant & auth
// ---------------------------------------------------------------------------

enum TenantType {
  advisor_firm
  sponsor_firm
}

model Tenant {
  id        String     @id @default(uuid())
  type      TenantType @default(advisor_firm)
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  advisorReps   AdvisorRep[]
  investors     Investor[]
  subscriptions Subscription[]
  auditEvents   AuditEvent[]

  // Phase 2 — sponsor_firm side
  sponsoredFunds         Fund[]                   @relation("FundSponsor")
  advisorEntitlements    FundAdvisorEntitlement[] @relation("EntitlementAdvisor")
  sponsoredEntitlements  FundAdvisorEntitlement[] @relation("EntitlementSponsor")
  sponsoredTemplates     DocumentTemplate[]
  sponsoredFieldMappings FieldMapping[]
  sponsoredSubscriptions Subscription[]           @relation("SubscriptionSponsor")

  @@map("tenants")
}

// gp_ops is a sponsor_firm-tenant-only role, enforced at the app layer
// (requireSponsorTenant middleware) rather than a DB cross-table constraint —
// same tradeoff as the tenantId/sponsorTenantId split above.
enum AdvisorRole {
  advisor_rep
  advisor_admin
  gp_ops
}

model AdvisorRep {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdvisorRole @default(advisor_rep)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions             Session[]
  investorsCreated     Investor[]              @relation("InvestorCreatedBy")
  subscriptionsCreated Subscription[]          @relation("SubscriptionCreatedBy")
  evidenceUploaded     AccreditationEvidence[]

  // Phase 2 — gp_ops side
  entitlementsGranted FundAdvisorEntitlement[]
  templatesUploaded   DocumentTemplate[]

  // Phase 3/4 — countersignatures
  signaturesGiven SignatureRequest[] @relation("SignatureSigner")

  @@index([tenantId])
  @@map("advisor_reps")
}

model Session {
  id           String     @id @default(uuid())
  tenantId     String
  advisorRepId String
  advisorRep   AdvisorRep @relation(fields: [advisorRepId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([advisorRepId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Investor
// ---------------------------------------------------------------------------

enum InvestorType {
  individual
  joint
  entity
  trust
}

// Reg D 501(a) accreditation bases. Individual/joint bases and entity/trust
// bases are mixed in one enum deliberately — the wizard filters the options
// shown based on InvestorType, but keeping one enum avoids a duplicated
// "kind of accreditation" concept and keeps AuditEvent/reporting queries
// simple (one column to group by regardless of investor type).
enum AccreditationBasis {
  individual_income // >$200k individual / >$300k joint income, 2 yrs + current-year expectation
  individual_net_worth // >$1M net worth excluding primary residence
  joint_net_worth_spousal_equivalent
  professional_certification // Series 7 / 65 / 82 license holder
  director_officer_or_gp_of_issuer // 501(a)(4) — affiliated with the fund's GP, regardless of income/net worth
  knowledgeable_employee // of the issuing fund
  entity_owners_all_accredited // every equity owner is independently accredited
  entity_assets_over_5m // entity/trust not formed for the purpose of investing, >$5M assets
  entity_investment_advisor
  entity_broker_dealer
  entity_bank_or_savings_institution
  entity_insurance_company
  entity_registered_investment_company
  entity_business_development_company
  entity_small_business_investment_company
  entity_erisa_plan // ERISA plan, investment decisions by bank/insurer/RIA, or assets > $5M
  entity_government_plan // state/federal employee benefit plan, assets > $5M
  entity_family_office // 2020 addition
  entity_family_client // 2020 addition
  entity_rural_business_investment_company
}

// Qualified purchaser bases under Investment Company Act §2(a)(51), plus the
// Rule 3c-5 knowledgeable-employee route. Distinct from AccreditationBasis and
// NOT a superset of it: accreditation (Reg D, ~$1M net worth / $200k income)
// gates a 3(c)(1) fund; QP status (~$5M in investments) gates a 3(c)(7) fund.
// An investor can easily be accredited without being a QP, which is exactly
// the case this enum exists to catch.
enum QualifiedPurchaserBasis {
  natural_person_5m // §2(a)(51)(A)(i) — individual/joint, ≥$5M in investments
  family_company_5m // §2(a)(51)(A)(ii) — family-owned company, ≥$5M in investments
  trust_qp_settlors // §2(a)(51)(A)(iii) — trust where trustees and settlors are all QPs
  institutional_25m // §2(a)(51)(A)(iv) — ≥$25M in investments, own or others' accounts
  qualified_institutional_buyer // Rule 144A QIB treated as QP
  knowledgeable_employee // Rule 3c-5 — may invest in a 3(c)(7) fund without being a QP
}

model Investor {
  id       String       @id @default(uuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  type     InvestorType

  // --- Individual / joint fields (nullable; required by type, enforced in app layer) ---
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  ssnLast4    String? // last 4 only in the core record; full TIN lives on the tax profile

  // --- Entity / trust fields ---
  entityName            String?
  entitySubtype         String? // e.g. "LLC", "Limited Partnership", "Revocable Trust" — free text for now
  formationJurisdiction String?

  // --- Shared contact/address ---
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  // --- Accreditation (Reg D 501(a)) — gates 3(c)(1) funds ---
  accreditationBasis      AccreditationBasis?
  accreditationDetails    Json? // self-attested supporting figures; shape varies by basis
  accreditationAttestedAt DateTime?

  // --- Qualified purchaser (ICA §2(a)(51)) — gates 3(c)(7) funds ---
  // Null means "not established", not "not a QP": absence blocks 3(c)(7)
  // subscriptions rather than being treated as a negative determination.
  qualifiedPurchaserBasis QualifiedPurchaserBasis?
  qpAttestedAt            DateTime?

  createdByRepId String
  createdByRep   AdvisorRep @relation("InvestorCreatedBy", fields: [createdByRepId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  principals    InvestorPrincipal[]
  taxProfile    InvestorTaxProfile?
  evidence      AccreditationEvidence[]
  subscriptions Subscription[]

  @@index([tenantId])
  @@map("investors")
}

// A natural person tied to an Investor: the individual themselves, a joint
// co-owner, a trustee, or an authorized signer on an entity account. Modeled
// as its own table from Phase 1 (rather than flat columns on Investor)
// because document execution — the whole point of this platform — routes
// signatures to individually identified signers, and that structure is not
// something to retrofit later.
enum PrincipalRole {
  primary
  joint_owner
  trustee
  authorized_signer
  entity_signer
}

model InvestorPrincipal {
  id               String        @id @default(uuid())
  tenantId         String
  investorId       String
  investor         Investor      @relation(fields: [investorId], references: [id], onDelete: Cascade)
  role             PrincipalRole
  firstName        String
  lastName         String
  email            String?
  title            String? // e.g. "Trustee", "Managing Member" — relevant for trust/entity signers
  isPrimaryContact Boolean       @default(false)
  createdAt        DateTime      @default(now())

  signatureRequests SignatureRequest[]

  @@index([tenantId])
  @@index([investorId])
  @@map("investor_principals")
}

enum TaxFormType {
  w9
  w8ben
}

// 1:1 with Investor. Split out from the core record because tax data (TIN,
// foreign status certifications) is more sensitive than profile data and
// this gives us a single place to apply stricter access/encryption controls
// later without touching the Investor table.
model InvestorTaxProfile {
  id         String      @id @default(uuid())
  tenantId   String
  investorId String      @unique
  investor   Investor    @relation(fields: [investorId], references: [id], onDelete: Cascade)
  formType   TaxFormType

  // --- W-9 branch (US person) ---
  w9TaxpayerIdType    String? // "ssn" | "ein"
  w9TaxpayerId        String? // full TIN — encrypt at rest in a later phase
  w9ExemptPayeeCode   String?
  w9BackupWithholding Boolean?

  // --- W-8BEN branch (foreign person) ---
  w8CountryOfCitizenship   String?
  w8ForeignTaxId           String?
  w8TreatyCountry          String?
  w8PermanentResidenceAddr String?

  certifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("investor_tax_profiles")
}

// File-upload stub: saves to local disk in Phase 1, no virus scan / OCR /
// KYC vendor integration. storagePath is a relative path under the server's
// configured upload root, never a public URL.
model AccreditationEvidence {
  id              String     @id @default(uuid())
  tenantId        String
  investorId      String
  investor        Investor   @relation(fields: [investorId], references: [id], onDelete: Cascade)
  fileName        String
  storagePath     String
  mimeType        String
  sizeBytes       Int
  uploadedByRepId String
  uploadedByRep   AdvisorRep @relation(fields: [uploadedByRepId], references: [id])
  createdAt       DateTime   @default(now())

  @@index([tenantId])
  @@index([investorId])
  @@map("accreditation_evidence")
}

// ---------------------------------------------------------------------------
// Fund, entitlements & document templates (Phase 2 — sponsor/GP side)
// ---------------------------------------------------------------------------

enum FundVehicleType {
  lp
  llc_feeder
  interval_fund
  non_traded_bdc
  evergreen
}

enum FundStructure {
  drawdown
  continuous
}

enum FundStatus {
  draft
  active
  closed
}

// Investment Company Act exclusion the fund relies on. This determines the
// INVESTOR ELIGIBILITY BAR, which is why it belongs on Fund rather than being
// inferred: a 3(c)(1) fund may take accredited investors, a 3(c)(7) fund may
// only take qualified purchasers (a materially higher standard). Sourced from
// Form ADV Schedule D 7.B.(1) in the real data.
enum FundExclusion {
  section_3c1 // ≤100 beneficial owners; accredited investors permitted
  section_3c7 // qualified purchasers only; no holder cap (subject to 12(g))
}

model Fund {
  id              String          @id @default(uuid())
  sponsorTenantId String
  sponsorTenant   Tenant          @relation("FundSponsor", fields: [sponsorTenantId], references: [id])
  name            String
  legalName       String?
  vehicleType     FundVehicleType
  structure       FundStructure
  minInvestment   Decimal?        @db.Decimal(18, 2)
  closeDate       DateTime? // nullable; only meaningful when structure = drawdown (app-layer enforced)
  status          FundStatus      @default(draft)
  gpSignatoryName String?

  // --- Form ADV Schedule D 7.B.(1) characteristics ---
  exclusion    FundExclusion? // drives the investor eligibility bar — see eligibility.ts
  domicile     String? // e.g. "Delaware", "Cayman Islands" — bears on W-9 vs W-8BEN
  isMasterFund Boolean        @default(false)
  isFeederFund Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  advisorEntitlements FundAdvisorEntitlement[]
  documentTemplates   DocumentTemplate[]
  subscriptions       Subscription[]

  @@index([sponsorTenantId])
  @@map("funds")
}

enum EntitlementStatus {
  active
  revoked
}

// Controls which advisor tenants can offer which funds. No advisor-side
// "browse funds" UI yet (Phase 2 scope) — this is grant/revoke by the
// sponsor only, data model ahead of the UI that will read it.
model FundAdvisorEntitlement {
  id              String            @id @default(uuid())
  fundId          String
  fund            Fund              @relation(fields: [fundId], references: [id])
  advisorTenantId String
  advisorTenant   Tenant            @relation("EntitlementAdvisor", fields: [advisorTenantId], references: [id])
  sponsorTenantId String // denormalized from fund.sponsorTenantId — direct query-layer scoping, no join needed
  sponsorTenant   Tenant            @relation("EntitlementSponsor", fields: [sponsorTenantId], references: [id])
  status          EntitlementStatus @default(active)
  grantedByRepId  String
  grantedByRep    AdvisorRep        @relation(fields: [grantedByRepId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([fundId, advisorTenantId])
  @@index([sponsorTenantId])
  @@index([advisorTenantId])
  @@map("fund_advisor_entitlements")
}

enum DocumentTemplateStatus {
  processing
  ready
  archived
}

model DocumentTemplate {
  id                String                 @id @default(uuid())
  sponsorTenantId   String // denormalized from fund.sponsorTenantId
  sponsorTenant     Tenant                 @relation(fields: [sponsorTenantId], references: [id])
  fundId            String
  fund              Fund                   @relation(fields: [fundId], references: [id])
  anvilTemplateId   String // Anvil Cast eid
  originalFilename  String
  status            DocumentTemplateStatus @default(processing)
  detectedFieldsRaw Json // raw Anvil createCast response, verbatim — mapping UI never re-calls Anvil
  uploadedByRepId   String
  uploadedByRep     AdvisorRep             @relation(fields: [uploadedByRepId], references: [id])
  uploadedAt        DateTime               @default(now())

  fieldMappings         FieldMapping[]
  subscriptionDocuments SubscriptionDocument[]

  @@index([sponsorTenantId])
  @@index([fundId])
  @@map("document_templates")
}

enum FieldMappingType {
  canonical
  static_value
  unmapped
}

model FieldMapping {
  id              String           @id @default(uuid())
  sponsorTenantId String // denormalized from template → fund → sponsorTenantId
  sponsorTenant   Tenant           @relation(fields: [sponsorTenantId], references: [id])
  templateId      String
  template        DocumentTemplate @relation(fields: [templateId], references: [id])
  anvilFieldKey   String // CastField.id from Anvil's detected fields
  anvilFieldLabel String? // CastField.name — display only
  mappingType     FieldMappingType @default(unmapped)
  canonicalField  String? // key into CANONICAL_FIELDS; required when mappingType = canonical
  staticValue     String? // required when mappingType = static_value
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([templateId, anvilFieldKey])
  @@index([sponsorTenantId])
  @@map("field_mappings")
}

// ---------------------------------------------------------------------------
// Subscription
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  draft
  pending_investor_data
  pending_signatures
  pending_gp_countersign
  pending_fund_admin_review
  accepted
  rejected
  funded
}

// The one dual-owned model in the system. A subscription is created by an
// advisor tenant (tenantId) but must also be visible to — and actionable by —
// the sponsor tenant whose fund it subscribes to (sponsorTenantId, denormalized
// from fund.sponsorTenantId at creation). scopedClient picks which column to
// filter on based on the caller's tenant TYPE, so neither side can see the
// other's unrelated subscriptions while both can see this one. See
// DUAL_TENANT_MODELS in src/db/scopedClient.ts.
model Subscription {
  id              String             @id @default(uuid())
  tenantId        String // advisor tenant that owns the investor relationship
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  sponsorTenantId String // sponsor tenant that owns the fund — denormalized from fund
  sponsorTenant   Tenant             @relation("SubscriptionSponsor", fields: [sponsorTenantId], references: [id])
  investorId      String
  investor        Investor           @relation(fields: [investorId], references: [id])
  fundId          String
  fund            Fund               @relation(fields: [fundId], references: [id])
  status          SubscriptionStatus @default(draft)
  amount          Decimal?           @db.Decimal(18, 2)

  // Lifecycle timestamps — set as the subscription moves through the state
  // machine (src/workflow/subscriptionStatus.ts). Nullable because a given
  // subscription may never reach that state.
  submittedAt     DateTime? // advisor sent it for signature
  signedAt        DateTime? // investor side fully signed
  countersignedAt DateTime? // GP countersigned
  decidedAt       DateTime? // accepted or rejected
  fundedAt        DateTime?
  rejectionReason String?

  createdByRepId String
  createdByRep   AdvisorRep @relation("SubscriptionCreatedBy", fields: [createdByRepId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  documents  SubscriptionDocument[]
  signatures SignatureRequest[]

  @@index([tenantId])
  @@index([sponsorTenantId])
  @@index([investorId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Generated documents & signatures
// ---------------------------------------------------------------------------

enum DocumentProviderKind {
  local // pdf-lib, on-disk — dev/demo
  anvil // Anvil fillPDF + Etch — production
}

// A generated (filled) subscription document. fieldValues is the resolved
// snapshot of exactly what was written into the PDF, stored verbatim: for an
// executed subscription doc, "what did the investor actually sign" is the
// question an auditor asks, and re-resolving it later from live records would
// answer a subtly different one.
model SubscriptionDocument {
  id               String               @id @default(uuid())
  tenantId         String
  sponsorTenantId  String
  subscriptionId   String
  subscription     Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  templateId       String
  template         DocumentTemplate     @relation(fields: [templateId], references: [id])
  provider         DocumentProviderKind
  storagePath      String // relative to UPLOAD_ROOT; never a public URL
  fieldValues      Json // { canonicalKey|anvilFieldKey: resolvedValue } as filled
  unresolvedFields Json // field keys that had no value at generation time
  generatedAt      DateTime             @default(now())

  signatures SignatureRequest[]

  @@index([tenantId])
  @@index([sponsorTenantId])
  @@index([subscriptionId])
  @@map("subscription_documents")
}

enum SignerRole {
  investor_signer
  gp_countersigner
}

enum SignatureStatus {
  pending
  signed
  declined
}

// One requested signature on a generated document. Signer identity is
// snapshotted (signerName/signerEmail) rather than only referenced, so a later
// rename or a deactivated rep never rewrites who signed a historical document.
model SignatureRequest {
  id              String               @id @default(uuid())
  tenantId        String
  sponsorTenantId String
  subscriptionId  String
  subscription    Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  documentId      String
  document        SubscriptionDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role            SignerRole
  sequence        Int // investor signers sign before the GP countersigns

  // Exactly one of these is set, per role.
  investorPrincipalId String?
  investorPrincipal   InvestorPrincipal? @relation(fields: [investorPrincipalId], references: [id])
  advisorRepId        String?
  advisorRep          AdvisorRep?        @relation("SignatureSigner", fields: [advisorRepId], references: [id])

  signerName  String
  signerEmail String?

  status SignatureStatus @default(pending)

  // Ceremony evidence. NOTE: this is the local provider's in-app signature —
  // signer intent + typed name + timestamp + IP. It is deliberately NOT a
  // legally compliant ESIGN/UETA e-signature; the Anvil Etch provider is what
  // production uses. Kept on the same model so the workflow shape doesn't
  // change when the provider does.
  signedAt      DateTime?
  typedName     String?
  ipAddress     String?
  userAgent     String?
  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([sponsorTenantId])
  @@index([subscriptionId])
  @@map("signature_requests")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  advisor_rep
  system
}

// Append-only by convention: no update/delete routes will ever target this
// table. Every write elsewhere in the app goes through the audit() helper,
// which is the only code path permitted to insert here.
model AuditEvent {
  id         String         @id @default(uuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  actorType  AuditActorType
  actorId    String? // AdvisorRep.id when actorType = advisor_rep; null for system
  action     String // e.g. "investor.created", "subscription.status_changed"
  entityType String // e.g. "Investor", "Subscription"
  entityId   String
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}
